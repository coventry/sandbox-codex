FROM node:25-trixie AS tmux-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        bison \
        flex \
        libevent-dev \
        libncurses-dev \
        pkg-config \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

ARG TMUX_VERSION=3.6
RUN curl -fsSL "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" -o /tmp/tmux.tar.gz \
    && tar -xzf /tmp/tmux.tar.gz -C /tmp \
    && cd /tmp/tmux-${TMUX_VERSION} \
    && ./configure \
    && make -j"$(nproc)" \
    && make install \
    && cd / \
    && rm -rf /tmp/tmux.tar.gz /tmp/tmux-${TMUX_VERSION}

FROM node:25-trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        curl \
        emacs-nox \
        jq \
        less \
	procps \
        python3 \
        python3-pip \
        python3-pytest \
        python3-venv \
        libevent-2.1-7 \
        libncursesw6 \
        libtinfo6 \
        ripgrep \
        rsync \
        zip \
        unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=tmux-builder /usr/local/bin/tmux /usr/local/bin/tmux
COPY --from=tmux-builder /usr/local/share/man/man1/tmux.1 /usr/local/share/man/man1/tmux.1

RUN npm install -g @openai/codex

# Ensure the install of uv goes to the right location.
USER node

ENV PATH="/node/.cargo/bin:${PATH}"
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

USER root

COPY docker-assets/tmux-snapshot-panes.sh /usr/local/bin/

COPY --chown=node:node docker-assets/tmux.conf /home/node/.tmux.conf
COPY --chown=node:node docker-assets/codex /home/node/.codex

# Copy in .profile, so that codex will have the correct .venv path
# when executing shell commands.
# https://github.com/openai/codex/issues/6243#issuecomment-3664477985
COPY --chown=node:node docker-assets/profile /home/node/.profile

WORKDIR /workspace/repo

CMD ["tail", "-f", "/dev/null"]
