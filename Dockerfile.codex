###################################################################################
FROM nvcr.io/nvidia/vllm:25.12.post1-py3 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        bison \
        flex \
        libevent-dev \
        libncurses-dev \
	libssl-dev \
        pkg-config \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install tmux
ARG TMUX_VERSION=3.6
RUN curl -fsSL "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" -o /tmp/tmux.tar.gz \
    && tar -xzf /tmp/tmux.tar.gz -C /tmp \
    && cd /tmp/tmux-${TMUX_VERSION} \
    && ./configure \
    && make -j"$(nproc)" \
    && make install \
    && cd / \
    && rm -rf /tmp/tmux.tar.gz /tmp/tmux-${TMUX_VERSION}


# Install rust
RUN curl https://sh.rustup.rs -sSf | bash -s -- -y

# Install ck, semantic search
ARG CK_VERSION=0.7.4
ENV PATH="/root/.cargo/bin:${PATH}"
RUN curl -fsSL "https://github.com/BeaconBay/ck/archive/refs/tags/${CK_VERSION}.tar.gz" -o /tmp/ck.tgz \
    && tar xf /tmp/ck.tgz -C /tmp \
    && cd /tmp/ck-${CK_VERSION} \
    && cargo build --release \
    && cp target/release/ck /usr/local/bin/

################################################################################
FROM nvcr.io/nvidia/vllm:25.12.post1-py3

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        curl \
        emacs-nox \
        jq \
        less \
	nodejs \
	npm \
	procps \
        python3 \
        python3-pip \
        python3-pytest \
        python3-venv \
        libevent-2.1-7 \
        libncursesw6 \
        libtinfo6 \
        ripgrep \
        rsync \
        unzip \
        zip \
        zstd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/tmux /usr/local/bin/tmux
COPY --from=builder /usr/local/share/man/man1/tmux.1 /usr/local/share/man/man1/tmux.1
COPY --from=builder /usr/lib/aarch64-linux-gnu/libevent_core-2.1.so.7 /usr/lib/aarch64-linux-gnu/
COPY --from=builder /usr/local/bin/ck /usr/local/bin/ck

# Ensure the install of uv goes to the right location.
USER ubuntu
ENV PATH="/home/ubuntu/.cargo/bin:${PATH}"
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh \
    | bash \
    && . /home/ubuntu/.nvm/nvm.sh \
    && nvm install --lts \
    && nvm use --lts && type node

USER root

COPY docker-assets/tmux-snapshot-panes.sh /usr/local/bin/

COPY --chown=ubuntu:ubuntu docker-assets/tmux.conf /home/ubuntu/.tmux.conf
COPY --chown=ubuntu:ubuntu docker-assets/codex /home/ubuntu/.codex

# Copy in .profile, so that codex will have the correct .venv path
# when executing shell commands.
# https://github.com/openai/codex/issues/6243#issuecomment-3664477985
COPY --chown=ubuntu:ubuntu docker-assets/profile /home/ubuntu/.profile

# Track codex token usage
# https://ccusage.com/guide/codex/
RUN npm install -g @ccusage/codex@latest

# These seemingly are always missing.
RUN pip install accelerate datasets matplotlib reportlab

# Put this last, as it is the most likely to need re-running.
RUN npm install -g @openai/codex 

WORKDIR /workspace/repo

CMD ["tail", "-f", "/dev/null"]
